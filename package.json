{
  "name": "ios-workout-pwa",
  "private": true,
  "version": "0.5.0",
  "description": "Local-first iOS weight-lifting workout PWA (FitBod-lite; idb is the sole runtime dep)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --https",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{json,html}\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.20.3",
    "eslint": "^9.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "uplot": "^1.6.32"
  }
}
